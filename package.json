{
  "name": "blockverse-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:desktop": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "electron:build": "npm run build && electron-builder",
    "preview": "vite preview --host 0.0.0.0",
    "start": "electron ."
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.4",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.blockverse.prototype",
    "productName": "BlockVerse Prototype",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "BlockVerse-Prototype-${version}.${ext}"
    }
  }
}
