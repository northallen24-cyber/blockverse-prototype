* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background: #0b1220;
  color: #f3f7ff;
}

body {
  display: block;
}

#game-shell {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #9ad9ff 0%, #dfefff 45%, #8ec9ff 100%);
}

#game-canvas {
  display: block;
  width: 100%;
  height: 100%;
  cursor: crosshair;
}

#hud {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

#title {
  position: absolute;
  top: 18px;
  left: 20px;
  font-size: 18px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 700;
  text-shadow: 0 3px 16px rgba(0, 0, 0, 0.5);
}

#status {
  position: absolute;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  min-width: 260px;
  text-align: center;
  background: rgba(10, 16, 22, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 14px;
  padding: 10px 16px;
  font-size: 13px;
  letter-spacing: 0.04em;
  backdrop-filter: blur(10px);
}

#quickbar {
  position: absolute;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
  pointer-events: auto;
}

.slot {
  width: 58px;
  height: 58px;
  border-radius: 12px;
  background: rgba(18, 22, 32, 0.58);
  border: 2px solid rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f4fbff;
  font-weight: 800;
  font-size: 12px;
  letter-spacing: 0.08em;
  box-shadow: 0 0 18px rgba(0, 0, 0, 0.2);
  position: relative;
  transition: transform 0.12s ease, border-color 0.12s ease;
}

.slot.selected {
  transform: translateY(-4px);
  border-color: #9bd7ff;
  box-shadow: 0 0 18px rgba(98, 179, 255, 0.75);
}

.slot::after {
  content: attr(data-key);
  position: absolute;
  bottom: 5px;
  right: 8px;
  font-size: 10px;
  opacity: 0.9;
}

#crosshair {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18px;
  height: 18px;
  transform: translate(-50%, -50%);
}

#crosshair::before,
#crosshair::after {
  content: '';
  position: absolute;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.4);
}

#crosshair::before {
  left: 8px;
  top: 0;
  width: 2px;
  height: 18px;
}

#crosshair::after {
  left: 0;
  top: 8px;
  width: 18px;
  height: 2px;
}

#inventory-panel {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: min(720px, 80vw);
  min-height: 260px;
  padding: 18px;
  border-radius: 18px;
  background: rgba(10, 15, 24, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(14px);
  box-shadow: 0 24px 56px rgba(0, 0, 0, 0.32);
  pointer-events: auto;
}

#inventory-panel.hidden {
  display: none;
}

.inventory-grid {
  display: grid;
  grid-template-columns: repeat(9, minmax(52px, 1fr));
  gap: 10px;
}

.inventory-cell {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
}

.inventory-title {
  margin: 0 0 14px;
  font-size: 14px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.9;
}

@media (max-width: 640px) {
  .slot {
    width: 46px;
    height: 46px;
  }

  #status {
    bottom: 84px;
    width: calc(100vw - 40px);
  }
}
